/*
 * nextflow.config — GIFTwrap pipeline configuration
 */

// Steps 2–5 modify the output directory in-place; copy staging prevents
// contaminating the upstream task's work directory.
process.stageInMode = 'copy'

env {
    NUMBA_CACHE_DIR = '/tmp/numba_cache'
    MPLCONFIGDIR    = '/tmp/mplconfig'
    PYTHONPATH      = '/data1/collab002/sail/projects/ongoing/tools/sail_giftwrap/sail_giftwrap/src'
}


process.container = 'docker://sailmskcc/giftwrap-sc:0.0.1'

singularity {
    enabled    = true
    autoMounts = true
    runOptions = "--bind /data1/collab002/sail/projects/ongoing/tools/sail_giftwrap/sail_giftwrap/src"
}

params {
    technology         = "Flex"
    reads_per_gapfill  = 0
    umi_edit_distance  = 1
    allow_chimeras     = false
    max_pcr_thresholds = 10
    multiplex          = 1
    flatten            = true
    ilab               = null
}


profiles {

    standard {
        process.executor = 'local'
    }

    slurm {
        process.executor = 'slurm'
        process.queue    = 'cpu'

        process {
            withName: 'COUNT_GAPFILLS' {
                cpus   = 8
                memory = '128 GB'
                time   = '10h'
            }
            withName: 'CUTADAPT_PREPROCESS' {
                cpus   = 4
                memory = '8 GB'
                time   = '2h'
            }
            withName: 'CORRECT_UMIS|CORRECT_GAPFILLS|COLLECT_COUNTS|SUMMARIZE_COUNTS' {
                cpus   = 8
                memory = '128 GB'
                time   = '3h'
            }
        }
    }
}
